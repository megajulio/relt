# ==============================================================================
# RELT Quickstart Configuration
# ==============================================================================

# Your Relt API Key (get it from https://relt.dev/dashboard/api-keys)
# Format: relt_live_xxxxxxxxxxxxx or relt_test_xxxxxxxxxxxxx
RELT_API_KEY=relt_test_your_api_key_here

# Phone number to send test messages (E.164 format: +countrycode number)
# Example: +573001234567 (Colombia)
TEST_PHONE=+1234567890

# Base URL for Relt API (only change if self-hosting)
RELT_API_BASE_URL=https://api.relt.dev

# Webhook receiver port (for receiving inbound messages)
WEBHOOK_PORT=3000

# Webhook secret (for signature verification - get from dashboard)
WEBHOOK_SECRET=your_webhook_secret_here
